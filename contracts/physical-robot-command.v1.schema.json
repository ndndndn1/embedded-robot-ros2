{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/contracts/physical-robot-command.v1.schema.json",
  "title": "Physical Robot Command v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["command_id", "robot_id", "kind", "ttl_ms", "expected_state_version", "payload"],
  "properties": {
    "command_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
    "robot_id": {"type": "string", "enum": ["MH-01", "MM-01"]},
    "kind": {"type": "string", "enum": ["navigate", "manipulate", "protective_stop"]},
    "ttl_ms": {"type": "integer", "minimum": 50, "maximum": 300000},
    "expected_state_version": {"type": "integer", "minimum": 0},
    "payload": {"type": "object"}
  }
}


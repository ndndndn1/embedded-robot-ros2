{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/contracts/physical-robot-status.v1.schema.json",
  "title": "Physical Robot Command Status v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["command_id", "robot_id", "phase", "sequence", "message", "updated_at"],
  "properties": {
    "command_id": {"type": "string"},
    "robot_id": {"type": "string"},
    "phase": {"enum": ["accepted", "running", "completed", "failed", "cancelled"]},
    "sequence": {"type": "integer", "minimum": 0},
    "message": {"type": "string"},
    "updated_at": {"type": "string", "format": "date-time"}
  }
}

